# Local PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spousepaypath

# Or discrete settings if DATABASE_URL is unset:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=spousepaypath

# Neon / hosted Postgres
# DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require
# PGSSL=require

SESSION_SECRET=spouse-pay-path-dev-session-secret-min-32-chars

# Production (Render): set DATABASE_URL, SESSION_SECRET, NODE_ENV=production, PGSSL=require
# Do not commit real secrets. Generate a new SESSION_SECRET for the live site.
